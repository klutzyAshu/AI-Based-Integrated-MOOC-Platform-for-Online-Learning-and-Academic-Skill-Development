# ============================================================
# Copy this file to .env and fill in real values for local dev.
# ============================================================

# --- Database (MariaDB) ---
DB_USERNAME=root
DB_PASSWORD=root
DB_URL=jdbc:mariadb://localhost:3306/mooc_platform?createDatabaseIfNotExist=true

# --- JWT ---
JWT_SECRET=change-this-super-secret-key-in-prod-please-change

# --- AI layer (OpenAI-compatible provider) ---
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# --- Storage ---
STORAGE_ROOT=./storage

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080/api
